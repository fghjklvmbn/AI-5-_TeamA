{
  "name": "memorypal-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "node scripts/build-profile.mjs main",
    "build:web:project3": "node scripts/build-profile.mjs project3",
    "serve:web": "python ../scripts/static_server.py --directory dist-main --host 0.0.0.0 --port 8081 --prefix /api_memoripal/main",
    "serve:web:project3": "python ../scripts/static_server.py --directory dist-project3 --host 0.0.0.0 --port 8083 --prefix /api_memoripal/project3/main",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "jest --config jest.config.cjs",
    "test:coverage": "jest --config jest.config.cjs --coverage"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.0",
    "expo-asset": "~56.0.19",
    "expo-audio": "~56.0.12",
    "expo-blur": "~56.0.3",
    "expo-document-picker": "~56.0.4",
    "expo-linear-gradient": "~56.0.4",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@types/react": "~19.2.0",
    "dotenv": "^17.4.2",
    "jest": "^29.7.0",
    "typescript": "~6.0.3"
  }
}
