# Copy this file to .env.scale. Never commit .env.scale.
# Replace both password placeholders before starting the containers.

# PostgreSQL + pgvector (host ports bind only to 127.0.0.1)
MEMORYPAL_POSTGRES_DB=memorypal
MEMORYPAL_POSTGRES_USER=memorypal_owner
# Required secret placeholder; intentionally empty so Compose fails closed.
MEMORYPAL_POSTGRES_PASSWORD=
MEMORYPAL_POSTGRES_PORT=5433
MEMORYPAL_POSTGRES_MAX_CONNECTIONS=200
MEMORYPAL_POSTGRES_SHARED_BUFFERS=256MB

# Redis ACL and persistence
MEMORYPAL_REDIS_USER=memorypal
# Required secret placeholder; use a different generated value.
MEMORYPAL_REDIS_PASSWORD=
MEMORYPAL_REDIS_PORT=6380
MEMORYPAL_REDIS_MAXMEMORY=512mb

# Gateway runtime wiring. Copy these values (with real URL-encoded passwords)
# into the root .env only after the SQLite backfill and verification step.
MEMORYPAL_DATABASE_URL=postgresql://memorypal_owner:__URL_ENCODED_POSTGRES_PASSWORD__@127.0.0.1:5433/memorypal
MEMORYPAL_DATABASE_SCHEMA=memorypal_gateway
MEMORYPAL_DATABASE_POOL_MIN_SIZE=2
MEMORYPAL_DATABASE_POOL_MAX_SIZE=20
MEMORYPAL_REDIS_URL=redis://memorypal:__URL_ENCODED_REDIS_PASSWORD__@127.0.0.1:6380/0
MEMORYPAL_REDIS_PREFIX=memorypal
MEMORYPAL_TASK_QUEUE_MODE=redis
MEMORYPAL_ADMIN_EMAILS=
MEMORYPAL_EMBEDDING_DIMENSIONS=768

# Gateway-to-Archive authentication. Do not rely on run.ps1's host-local
# .runtime token when the services run independently or on multiple hosts.
# Generate one URL-safe secret from at least 48 random bytes and distribute the
# exact same value to every Gateway and Archive instance via a secret manager.
MEMORYPAL_ARCHIVE_SERVICE_TOKEN=
MEMORYPAL_ARCHIVE_REGISTRATION_CLEANUP_DELAY=1200
