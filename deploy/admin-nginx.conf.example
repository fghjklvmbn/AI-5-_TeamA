# This block belongs on the external developark.duckdns.org Nginx server.
# MemoryPal's internal Windows host only serves the built admin app on 8082;
# it does not need another Nginx instance.

location = /api_memoripal/manage {
    return 308 /api_memoripal/manage/;
}

location /api_memoripal/manage/ {
    proxy_pass http://192.168.2.75:8082/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 30s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
    send_timeout 300s;
}
