# Copy this file to .env at the repository root. Never commit the real .env.

# Gateway authentication and local database
MEMORYPAL_JWT_SECRET=replace-with-at-least-32-random-characters
MEMORYPAL_JWT_MINUTES=720
MEMORYPAL_DATABASE_PATH=./backend/gateway/data/memorypal.db
MEMORYPAL_ROOT_PATH=/api_memoripal/gateway
MEMORYPAL_CORS_ORIGINS=https://developark.duckdns.org,http://localhost:8081,http://localhost:19006

# Model and supporting services
MEMORYPAL_STT_URL=http://192.168.2.75:8001
MEMORYPAL_LLM_URL=https://developark.duckdns.org/api_memoripal/llm/v1
MEMORYPAL_LLM_API_KEY=lm-studio
MEMORYPAL_DEFAULT_LLM_MODEL=qwen3.5-4b
MEMORYPAL_COMPANION_LLM_MODEL=memorypal_ai
MEMORYPAL_TTS_URL=http://192.168.2.75:8003
MEMORYPAL_TTS_PUBLIC_URL=https://developark.duckdns.org/api_memoripal/tts
MEMORYPAL_ARCHIVE_URL=http://192.168.2.75:8004
MEMORYPAL_ARCHIVE_PUBLIC_URL=https://developark.duckdns.org/api_memoripal/archive
MEMORYPAL_DEFAULT_VOICE_ID=00000000-0000-0000-0000-000000000001
MEMORYPAL_REQUEST_TIMEOUT=300

# Archive PostgreSQL. Put the real password only in the ignored root .env.
MEMORYPAL_ARCHIVE_DATABASE_URL=postgresql://postgres@localhost:5432/memoripal

# Expo embeds EXPO_PUBLIC_* values in the frontend bundle; never place secrets here.
EXPO_PUBLIC_API_URL=https://developark.duckdns.org/api_memoripal/gateway/v1
