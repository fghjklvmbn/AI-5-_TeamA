# Copy this file to .env at the repository root. Never commit the real .env.

# Gateway authentication and administrator access. install.cmd creates the
# ignored file below. In hosted deployments, inject MEMORYPAL_JWT_SECRET from
# a secret manager instead and leave the file setting unused.
MEMORYPAL_JWT_SECRET=
# install.cmd fills this for local use. Leave it blank when injecting the
# direct variable from a hosted secret manager.
MEMORYPAL_JWT_SECRET_FILE=
MEMORYPAL_JWT_MINUTES=720
# Comma-separated login emails. Leave empty until an administrator is assigned.
MEMORYPAL_ADMIN_EMAILS=

# Gateway database and runtime
# Leave DATABASE_URL empty for the bundled SQLite setup. Scale deployments use
# the PostgreSQL URL described in .env.scale.example.
MEMORYPAL_DATABASE_PATH=./backend/gateway/data/memorypal.db
MEMORYPAL_DATABASE_URL=
MEMORYPAL_DATABASE_SCHEMA=memorypal_gateway
MEMORYPAL_DATABASE_POOL_MIN_SIZE=2
MEMORYPAL_DATABASE_POOL_MAX_SIZE=20
MEMORYPAL_REDIS_URL=
MEMORYPAL_REDIS_PREFIX=memorypal
MEMORYPAL_TASK_QUEUE_MODE=local
MEMORYPAL_ROOT_PATH=/api_memoripal/gateway
# CORS is a browser boundary, not authentication. Production should retain
# only its HTTPS origin; localhost entries are for local development.
MEMORYPAL_CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081,http://127.0.0.1:8082,http://localhost:19006
# Keep services local by default. Set 0.0.0.0 only when a separate trusted LAN
# Nginx host must reach these ports, and restrict them with the host firewall.
MEMORYPAL_PUBLIC_BIND_HOST=127.0.0.1

# Model and supporting services on the internal service host
# Gateway, STT and TTS receive this credential through process memory. Never
# put it in EXPO_PUBLIC_* or VITE_* variables because those are browser-visible.
MEMORYPAL_MODEL_SERVICE_TOKEN=
MEMORYPAL_MODEL_SERVICE_TOKEN_FILE=
MEMORYPAL_STT_URL=http://192.168.2.75:8001
MEMORYPAL_LLM_URL=http://192.168.2.41:1234/v1
MEMORYPAL_LLM_API_KEY=lm-studio
MEMORYPAL_DEFAULT_LLM_MODEL=qwen/qwen3.5-9b
MEMORYPAL_COMPANION_LLM_MODEL=memorypal_ai
MEMORYPAL_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
MEMORYPAL_EMBEDDING_DIMENSIONS=768
MEMORYPAL_TTS_URL=http://192.168.2.75:8003
MEMORYPAL_TTS_PUBLIC_URL=http://127.0.0.1:8003
MEMORYPAL_TTS_ENGINE=qwen
MEMORYPAL_ARCHIVE_URL=http://192.168.2.75:8004
MEMORYPAL_ARCHIVE_PUBLIC_URL=http://127.0.0.1:8004
# Shared Gateway-to-Archive credential. For the bundled run.cmd workflow this
# may stay blank: run.ps1 creates and reuses
# .runtime/secrets/archive-service-token.
# For independent or multi-host processes, inject the same non-empty secret
# into every Gateway and Archive instance through the deployment secret store.
MEMORYPAL_ARCHIVE_SERVICE_TOKEN=
# Use exactly one source. run.cmd fills this local file setting automatically;
# leave it blank when the direct value is injected by a hosted secret manager.
MEMORYPAL_ARCHIVE_SERVICE_TOKEN_FILE=
MEMORYPAL_ARCHIVE_REGISTRATION_CLEANUP_DELAY=1200
MEMORYPAL_DEFAULT_VOICE_ID=00000000-0000-0000-0000-000000000001
MEMORYPAL_REQUEST_TIMEOUT=300
MEMORYPAL_WEB_SEARCH_MAX_RESULTS=4

# Archive PostgreSQL. Put the real password only in the ignored root .env.
MEMORYPAL_ARCHIVE_DATABASE_URL=postgresql://postgres@localhost:5432/memoripal

# Profile-specific build inputs produce separate dist-main and dist-project3
# directories. These values are public by definition and must never be secrets.
MEMORYPAL_MAIN_PUBLIC_API_URL=http://127.0.0.1:8000/v1
MEMORYPAL_PROJECT3_PUBLIC_API_URL=http://127.0.0.1:8010/v1
# Expo development-server compatibility; the main profile uses this only when
# MEMORYPAL_MAIN_PUBLIC_API_URL is absent.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/v1
