# MemoryPal shared environment configuration
# Copy this file to .env and replace every CHANGE_ME value before production use.

# Gateway authentication and local storage
MEMORYPAL_JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
MEMORYPAL_JWT_MINUTES=720
MEMORYPAL_DATABASE_PATH=./backend/gateway/data/memorypal.db
MEMORYPAL_ROOT_PATH=
MEMORYPAL_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006

# AI service endpoints
MEMORYPAL_STT_URL=http://127.0.0.1:8001
MEMORYPAL_LLM_URL=http://127.0.0.1:1234/v1
MEMORYPAL_LLM_API_KEY=CHANGE_ME_IF_REQUIRED
MEMORYPAL_DEFAULT_LLM_MODEL=qwen3.5-4b
MEMORYPAL_COMPANION_LLM_MODEL=memorypal_ai
MEMORYPAL_TTS_URL=http://127.0.0.1:8003
MEMORYPAL_TTS_PUBLIC_URL=http://127.0.0.1:8003
MEMORYPAL_ARCHIVE_URL=http://127.0.0.1:8004
MEMORYPAL_ARCHIVE_PUBLIC_URL=http://127.0.0.1:8004
MEMORYPAL_ARCHIVE_SERVICE_TOKEN=CHANGE_ME_USE_A_SHARED_INTERNAL_TOKEN
MEMORYPAL_DEFAULT_VOICE_ID=00000000-0000-0000-0000-000000000001
MEMORYPAL_REQUEST_TIMEOUT=300

# Archive PostgreSQL connection
MEMORYPAL_ARCHIVE_DATABASE_URL=postgresql://memorypal:CHANGE_ME@127.0.0.1:5432/memorypal

# Frontend and administrator account
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/v1
MEMORYPAL_ADMIN_EMAILS=admin@example.com
