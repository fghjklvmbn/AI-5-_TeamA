# Copy to .runtime/model-node.env on the model computer.
# Use the exact same token in the main computer's .runtime/docker.env.
MEMORYPAL_MODEL_SERVICE_TOKEN=replace-with-at-least-32-random-characters

# Public address clients use to fetch generated TTS output.
MEMORYPAL_MODEL_PUBLIC_URL=http://MODEL_COMPUTER_IP:8090
MEMORYPAL_MODEL_BIND_ADDRESS=0.0.0.0
MEMORYPAL_MODEL_PROXY_PORT=8090
